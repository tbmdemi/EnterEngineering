# Local/VPS production template. Copy to .env and replace every change-me value.
APP_DOMAIN=demo.example.com
APP_ENV=production

POSTGRES_DB=careguard
POSTGRES_USER=careguard
POSTGRES_PASSWORD=change-me-with-a-long-random-password

DEMO_ACCESS_TOKEN=change-me-with-a-separate-long-random-access-key
ALLOWED_HOSTS=demo.example.com
ENABLE_API_DOCS=false

# The demo uses deterministic extraction unless explicitly switched to live.
AI_MODE=fixture
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
